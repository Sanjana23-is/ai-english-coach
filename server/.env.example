PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
POSTGRES_USER=englishcoach
POSTGRES_PASSWORD=englishcoach_dev_password
POSTGRES_DB=englishcoach_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
DATABASE_URL=postgresql://englishcoach:englishcoach_dev_password@localhost:5434/englishcoach_db

# Conversation AI Provider (ollama | mock)
CONVERSATION_AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_MS=30000

# Speech-to-Text (STT) Provider (whisper | mock)
STT_PROVIDER=whisper
WHISPER_BASE_URL=http://localhost:8000
WHISPER_MODEL=base.en
WHISPER_TIMEOUT_MS=30000

# Text-to-Speech (TTS) Provider (piper | mock)
TTS_PROVIDER=piper
PIPER_BASE_URL=http://localhost:5001
PIPER_MODEL=en_US-lessac-medium
PIPER_TIMEOUT_MS=30000
