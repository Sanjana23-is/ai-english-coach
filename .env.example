# ==============================================
# AI English Coach - Environment Configuration
# Copy this file to .env before starting services
# ==============================================

# Server Configuration
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
POSTGRES_USER=englishcoach
POSTGRES_PASSWORD=englishcoach_dev_password
POSTGRES_DB=englishcoach_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Local AI Services (Planned)
OLLAMA_BASE_URL=http://localhost:11434
WHISPER_BASE_URL=http://localhost:8000
PIPER_BASE_URL=http://localhost:5001
